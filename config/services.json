    },
    {
      "name": "open-webui",
      "displayName": "Open WebUI",
      "controller": "docker",
      "container": "open-webui",
      "type": "generic",
      "url": "http://localhost:8080"
    },
    {
      "name": "searxng",
      "displayName": "SearXNG",
      "controller": "docker",
      "container": "searxng",
      "type": "generic",
      "url": "http://localhost:8888"
    },
    {
      "name": "speaches",
