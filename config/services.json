{
  "services": [
    {
      "name": "ollama",
      "displayName": "Ollama",
      "controller": "systemd",
      "unit": "ollama.service",
      "type": "ollama",
      "url": "http://localhost:11434",
      "modelDir": "/usr/share/ollama/.ollama/models"
    },
    {
      "name": "comfyui",
      "displayName": "ComfyUI",
      "controller": "systemd",
      "unit": "comfyui.service",
      "type": "comfyui",
      "url": "http://localhost:8188",
      "modelDir": "/home/dibza/ComfyUI/models"
    },
    {
      "name": "sillytavern",
      "displayName": "SillyTavern",
      "controller": "systemd",
      "unit": "sillytavern.service",
      "type": "generic",
